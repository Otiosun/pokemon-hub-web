{
  "name": "pokemon-control-center",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-performance-budget.mjs",
    "preview": "vite preview",
    "check": "biome check src vite.config.ts",
    "format:check": "biome format src vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm check && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
