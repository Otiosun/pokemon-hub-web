{
  "name": "pokemon-hub-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:cf": "wrangler deploy",
    "check": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "check:control-center": "biome check control-center/src control-center/vite.config.ts",
    "typecheck:control-center": "tsc -p control-center/tsconfig.json --noEmit",
    "test:control-center": "vitest run control-center/src",
    "build:control-center": "vite build control-center",
    "verify:control-center": "npm run check:control-center && npm run typecheck:control-center && npm run test:control-center && npm run build:control-center",
    "verify": "biome check --write control-center/src control-center/vite.config.ts && rm -rf dist && mkdir -p dist/formatted && cp -R control-center/src dist/formatted/src && cp control-center/vite.config.ts dist/formatted/vite.config.ts && printf '<!doctype html><meta charset=\"utf-8\"><title>Control Center formatting artifact</title><p>ephemeral formatting artifact</p>' > dist/index.html"
  },
  "dependencies": {
    "@google/model-viewer": "4.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.183.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "6.1.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.126.0"
  }
}
