{
  "name": "pokemon-hub-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "probe:home": "python3 scripts/probe-pokemon-home.py",
    "verify": "python3 -m pip install --disable-pip-version-check --quiet UnityPy==1.25.3 && python3 scripts/probe-pokemon-home.py && biome lint . && tsc --noEmit && vitest run && vite build"
  },
  "dependencies": {
    "@google/model-viewer": "4.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.183.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
