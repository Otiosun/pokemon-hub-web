{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/hub/admin/premium-auth/self",
      "destination": "/api/hub/admin/premium?__premium_route=auth-self"
    },
    {
      "source": "/api/hub/admin/premium-auth/player",
      "destination": "/api/hub/admin/premium?__premium_route=auth-player"
    },
    {
      "source": "/api/hub/admin/premium-auth/exchange",
      "destination": "/api/hub/admin/premium?__premium_route=auth-exchange"
    },
    {
      "source": "/api/hub/admin/premium-auth/logout",
      "destination": "/api/hub/admin/premium?__premium_route=auth-logout"
    },
    {
      "source": "/api/hub/admin/premium/delivery",
      "destination": "/api/hub/admin/premium?__premium_route=delivery"
    },
    {
      "source": "/api/hub/admin/premium/players",
      "destination": "/api/hub/admin/premium?__premium_route=players"
    },
    {
      "source": "/api/hub/admin/premium/delivery/catalog",
      "destination": "/api/hub/admin/premium?__premium_route=catalog"
    },
    {
      "source": "/api/hub/admin/premium/delivery/items",
      "destination": "/api/hub/admin/premium?__premium_route=items"
    },
    {
      "source": "/api/hub/admin/premium/delivery/pokemon",
      "destination": "/api/hub/admin/premium?__premium_route=pokemon"
    },
    {
      "source": "/api/hub/admin/premium/delivery/cases",
      "destination": "/api/hub/admin/premium?__premium_route=cases"
    },
    {
      "source": "/api/hub/admin/premium/delivery/cases/catalog",
      "destination": "/api/hub/admin/premium?__premium_route=cases-catalog"
    },
    {
      "source": "/api/hub/admin/premium/delivery/packs/master",
      "destination": "/api/hub/admin/premium?__premium_route=master"
    },
    {
      "source": "/api/hub/admin/premium/delivery/cases/:caseId/events",
      "destination": "/api/hub/admin/premium?__premium_route=case-events&__premium_case=:caseId"
    },
    {
      "source": "/api/hub/admin/premium/delivery/cases/:caseId/transition",
      "destination": "/api/hub/admin/premium?__premium_route=case-transition&__premium_case=:caseId"
    },
    {
      "source": "/api/hub/admin/team/:principalId/reception-staff",
      "destination": "/api/hub/admin/team?principalId=:principalId&action=reception-staff"
    },
    {
      "source": "/api/hub/admin/operations/:operationId/:action",
      "destination": "/api/hub/admin/operations?operationId=:operationId&action=:action"
    },
    {
      "source": "/api/hub/admin/players/:playerId/adjustments",
      "destination": "/api/hub/admin/players?playerId=:playerId&action=adjustments"
    },
    {
      "source": "/api/hub/admin/players/:playerId",
      "destination": "/api/hub/admin/players?playerId=:playerId"
    },
    {
      "source": "/api/hub/admin/team/:principalId/capabilities",
      "destination": "/api/hub/admin/team?principalId=:principalId&action=capabilities"
    },
    {
      "source": "/champion-store/rotomdex-ultra.jpg",
      "destination": "/champion-store/rotomdex-ultra.webp"
    },
    {
      "source": "/champion-store/master-ball.jpg",
      "destination": "/champion-store/master-ball.webp"
    },
    {
      "source": "/champion-store/save-ash.jpg",
      "destination": "/champion-store/save-ash.webp"
    },
    {
      "source": "/champion-store/save-brock.jpg",
      "destination": "/champion-store/save-brock.webp"
    },
    {
      "source": "/champion-store/save-cynthia.jpg",
      "destination": "/champion-store/save-cynthia.webp"
    },
    {
      "source": "/:path((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval'; script-src-attr 'none'; style-src 'self'; style-src-elem 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob: https://raw.githubusercontent.com https://play.pokemonshowdown.com https://archives.bulbagarden.net https://*.r2.dev https://*.cloudflarestorage.com; connect-src 'self' https://raw.githubusercontent.com https://pokeapi.co https://*.r2.dev https://*.cloudflarestorage.com; font-src 'self'; media-src 'self' blob: data: https://opengameart.org; frame-src 'none'; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
        }
      ]
    }
  ],
  "env": {
    "PLAYER_PORTAL_API_BASE_URL": "https://pokemon-api.otiosunbots.xyz"
  }
}
